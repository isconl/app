<?xml version="1.0" encoding="utf-8"?>
<!-- BI26100138: long-press the app icon for Capture and Today. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_widget_add"
        android:shortcutId="capture"
        android:shortcutLongLabel="@string/shortcut_capture_long"
        android:shortcutShortLabel="@string/widget_capture">
        <intent
            android:action="com.sconl.isconl.action.CAPTURE"
            android:targetClass="com.sconl.isconl.MainActivity"
            android:targetPackage="com.sconl.isconl" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_widget_today"
        android:shortcutId="today"
        android:shortcutLongLabel="@string/shortcut_today_long"
        android:shortcutShortLabel="@string/shortcut_today">
        <intent
            android:action="com.sconl.isconl.action.TODAY"
            android:targetClass="com.sconl.isconl.MainActivity"
            android:targetPackage="com.sconl.isconl" />
    </shortcut>
</shortcuts>
