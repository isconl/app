<?xml version="1.0" encoding="utf-8"?>
<!-- BI26100138: the home-screen widget. Plain RemoteViews: no network, no Flutter, only what the app last wrote. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_block_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_now"
        android:textColor="#8b949e"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_open_app"
        android:textColor="#e6edf3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_block_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#8b949e"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_next_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_next"
        android:textColor="#8b949e"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#e6edf3"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_capture"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="@string/widget_capture"
            android:textColor="#e6edf3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_mic"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="@string/widget_mic"
            android:textColor="#e6edf3"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_asof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#6e7681"
        android:textSize="10sp" />
</LinearLayout>
