# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# local build deliverables
/dist/
# custom launcher art is intentionally tracked
!/branding/

# Sync conflict debris. OneDrive and the vault sync both leave .conflict-N
# copies beside the original, and on 29 Jul two of them held the APK keystore
# passwords while key.properties itself had been destroyed - un-ignored, so one
# git add away from publishing the signing credentials. Never committable.
*.conflict
*.conflict[0-9]
*.conflict-*
*.backup-*
